# ─── Core ────────────────────────────────────────────────────────────────────
# Local development uses SQLite. Production: switch the Prisma datasource
# provider to "postgresql" (see docs/DEPLOYMENT.md) and use a PostgreSQL URL.
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NODE_ENV is set by Next.js. Do not pin it in a production .env.

# 32+ random characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production startup rejects this development value.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Separate AES-256-GCM key for encrypted drafts and birth fields (base64, 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=""

# ─── AI provider ─────────────────────────────────────────────────────────────
# local | openai | gemini   (local = deterministic, no network calls, no vision)
AI_PROVIDER="local"
AI_MODEL=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_MONTHLY_BUDGET_USD="5"
AI_MAX_OUTPUT_TOKENS="2500"
AI_TIMEOUT_MS="45000"

# ─── Astrology ───────────────────────────────────────────────────────────────
# internal (astronomy-engine, MIT) | external
ASTROLOGY_PROVIDER="internal"
ASTROLOGY_PROVIDER_API_KEY=""
ASTROLOGY_PROVIDER_URL=""
ASTROLOGY_DEFAULT_AYANAMSA="LAHIRI"

# ─── Storage ─────────────────────────────────────────────────────────────────
# local (private filesystem, dev) | s3 (production)
STORAGE_PROVIDER="local"
# Local root. Defaults to ./.data/uploads when empty.
STORAGE_DIR=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
# Set for MinIO/R2/other S3-compatible services (enables path-style URLs).
STORAGE_ENDPOINT=""
STORAGE_REGION=""

# ─── Queue / worker ──────────────────────────────────────────────────────────
# The database-backed queue needs no broker. The worker polls these intervals.
WORKER_POLL_MS="2000"
WORKER_BATCH="3"
# Optional: reserved for a shared rate-limit/cache adapter in multi-instance deployments.
REDIS_URL=""

# ─── Email ───────────────────────────────────────────────────────────────────
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="readings@aibaba.local"

# ─── PDF ─────────────────────────────────────────────────────────────────────
# Path to Chrome/Edge for HTML→PDF rendering. Auto-detected when empty.
CHROMIUM_EXECUTABLE_PATH=""

# ─── Seed accounts ───────────────────────────────────────────────────────────
# Local demo data only. Set SEED_DEMO_ACCOUNTS=false before any shared deployment.
SEED_DEMO_ACCOUNTS="true"
DEMO_PASSWORD="Aibaba@2026"
ADMIN_PASSWORD="AibabaAdmin@2026"

# ─── Payments (disabled unless explicitly enabled) ──────────────────────────
PAYMENTS_ENABLED="false"
PAYMENT_PROVIDER="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
