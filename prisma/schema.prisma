// AIBABA Complete Life Reading — normalized relational schema.
//
// Local development uses SQLite. For production, switch the datasource
// provider to "postgresql" (see docs/DEPLOYMENT.md). Structured JSON is stored
// as validated JSON strings in `String` columns so the schema stays portable;
// on PostgreSQL these can be migrated to `JsonB` without changing application
// contracts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  passwordHash      String
  preferredLanguage String   @default("en")
  accountStatus     String   @default("ACTIVE") // ACTIVE | LOCKED | PENDING
  role              String   @default("USER") // USER | SUPPORT | CONTENT_EDITOR | OPERATIONS_ADMIN | SUPER_ADMIN
  emailVerifiedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profile          UserProfile?
  sessions         Session[]
  birthProfiles    BirthProfile[]
  consents         ConsentRecord[]
  readings         CompleteReading[]
  reports          CompleteLifeReport[]
  palmAnalyses     PalmAnalysis[]
  numerologyAnalyses NumerologyAnalysis[]
  astrologyCalculations AstrologyCalculation[]
  assets           UploadedAsset[]
  conversations    AIConversation[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  deletionRequests DataDeletionRequest[]
  entitlements     Entitlement[]
  payments         PaymentTransaction[]
  reportShares     ReportShare[]

  @@index([createdAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  country     String?
  timezone    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BirthProfile {
  id                    String   @id @default(cuid())
  userId                String
  encryptedFullName     String?
  encryptedDateOfBirth  String?
  birthTime             String?
  birthTimeAccuracy     String   @default("UNKNOWN") // EXACT | APPROXIMATE | UNKNOWN
  birthplaceName        String?
  latitude              Float?
  longitude             Float?
  timezone              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  readings CompleteReading[]

  @@index([userId])
}

model ConsentRecord {
  id             String    @id @default(cuid())
  userId         String
  readingId      String?
  purpose        String // PERSONAL_DATA_PROCESSING | AI_PROCESSING | PALM_IMAGE_PROCESSING | SAVE_HISTORY | PRODUCT_RESEARCH
  consentVersion String
  granted        Boolean
  grantedAt      DateTime?
  withdrawnAt    DateTime?
  metadata       String?
  createdAt      DateTime  @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reading CompleteReading? @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([readingId])
}

// ─── Reading orchestration ──────────────────────────────────────────────────

model CompleteReading {
  id                   String    @id @default(cuid())
  userId               String
  birthProfileId       String?
  status               String    @default("DRAFT") // DRAFT | AWAITING_CONSENT | READY | QUEUED | PROCESSING | PARTIALLY_COMPLETED | COMPLETED | FAILED | CANCELLED | DELETION_PENDING | DELETED
  selectedModules      String    @default("[]") // JSON array: PALMISTRY | NUMEROLOGY | ASTROLOGY
  language             String    @default("en")
  inputSnapshotVersion Int       @default(1)
  reportVersion        Int       @default(0)
  currentStep          Int       @default(0)
  draftData            String? // wizard draft JSON (validated)
  errorCode            String?
  submittedAt          DateTime?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthProfile  BirthProfile?          @relation(fields: [birthProfileId], references: [id], onDelete: SetNull)
  consents      ConsentRecord[]
  assets        UploadedAsset[]
  palmAnalysis  PalmAnalysis?
  numerology    NumerologyAnalysis?
  astrology     AstrologyCalculation?
  reports       CompleteLifeReport[]
  conversations AIConversation[]
  jobs          BackgroundJob[]
  shares        ReportShare[]
  deletionRequest DataDeletionRequest?
  notifications Notification[]

  @@index([userId, createdAt])
  @@index([status])
}

model UploadedAsset {
  id               String    @id @default(cuid())
  userId           String
  readingId        String?
  storageKey       String    @unique
  assetType        String // PALM_LEFT | PALM_RIGHT | PALM_EXTRA | PROFILE_IMAGE
  mimeType         String
  fileSize         Int
  imageWidth       Int?
  imageHeight      Int?
  checksum         String
  qualityMetadata  String?
  processingStatus String    @default("UPLOADED") // PENDING | UPLOADED | VALIDATED | NEEDS_REUPLOAD | REJECTED | DELETED
  retentionStatus  String    @default("ACTIVE") // ACTIVE | EXPIRED | DELETED
  errorCode        String?
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reading CompleteReading? @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readingId])
}

model PalmAnalysis {
  id                    String   @id @default(cuid())
  readingId             String   @unique
  userId                String
  dominantHand          String? // LEFT | RIGHT
  leftAssetId           String?
  rightAssetId          String?
  imageQuality          String? // JSON: quality metrics + pass/fail
  visibleFeatures       String? // JSON array of structured features
  structuredObservations String? // JSON
  interpretation        String? // JSON: traditional interpretation sections
  confidenceMetadata    String? // JSON
  modelVersion          String?
  promptVersion         String?
  status                String   @default("PENDING") // PENDING | VALIDATING | NEEDS_REUPLOAD | COMPLETED | LIMITED | FAILED
  errorCode             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  reading CompleteReading @relation(fields: [readingId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NumerologyAnalysis {
  id                String   @id @default(cuid())
  readingId         String   @unique
  userId            String
  system            String // CHALDEAN | PYTHAGOREAN
  mappingVersion    String
  calculationInput  String // JSON
  calculationSteps  String // JSON
  calculationResults String // JSON
  interpretation    String? // JSON
  status            String   @default("PENDING") // PENDING | COMPLETED | FAILED
  errorCode         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reading CompleteReading @relation(fields: [readingId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AstrologyCalculation {
  id                    String   @id @default(cuid())
  readingId             String   @unique
  userId                String
  provider              String
  providerVersion       String
  calculationSettings   String // JSON
  birthTimeAccuracy     String
  locationSnapshot      String? // JSON
  planetaryPositions    String? // JSON
  chartData             String? // JSON (D1, D9, houses, nakshatras)
  dashaData             String? // JSON
  transitData           String? // JSON
  uncertaintyMetadata   String? // JSON
  interpretation        String? // JSON — AI-assisted explanation of validated chart data
  calculationStatus     String   @default("PENDING") // PENDING | COMPLETED | LIMITED | FAILED
  errorCode             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  reading CompleteReading @relation(fields: [readingId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CompleteLifeReport {
  id                String   @id @default(cuid())
  readingId         String
  userId            String
  version           Int      @default(1)
  reportContent     String // JSON: versioned report document
  synthesisMetadata String // JSON: modules used, providers, versions, integrity notes
  promptVersion     String
  aiModel           String
  status            String   @default("FINAL") // DRAFT | FINAL | SUPERSEDED
  createdAt         DateTime @default(now())

  reading CompleteReading @relation(fields: [readingId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([readingId, version])
  @@index([userId])
}

// ─── Conversations ──────────────────────────────────────────────────────────

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  readingId String?
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reading  CompleteReading? @relation(fields: [readingId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id                 String   @id @default(cuid())
  conversationId     String
  role               String // user | assistant
  content            String
  structuredMetadata String?
  tokenUsage         String? // JSON, no prompt content
  createdAt          DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AIUsage {
  id           String   @id @default(cuid())
  userId       String?
  readingId    String?
  task         String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  latencyMs    Int      @default(0)
  success      Boolean  @default(true)
  errorCode    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([readingId])
}

// ─── Operations ─────────────────────────────────────────────────────────────

model BackgroundJob {
  id             String    @id @default(cuid())
  readingId      String?
  jobType        String
  status         String    @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | DEAD | CANCELLED
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(4)
  idempotencyKey String    @unique
  payload        String?
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  errorCode      String?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reading CompleteReading? @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([readingId])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  safeMetadata String? // JSON — never contents, images, birth details or secrets
  ipHash       String?
  timestamp    DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, timestamp])
  @@index([resourceType, resourceId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  readingId String?
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reading CompleteReading? @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model DataDeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  readingId   String?   @unique
  status      String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | REJECTED
  reason      String?
  notes       String?
  requestedAt DateTime  @default(now())
  processedAt DateTime?

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reading CompleteReading? @relation(fields: [readingId], references: [id], onDelete: Cascade)
}

model ReportShare {
  id        String    @id @default(cuid())
  userId    String
  readingId String
  reportId  String?
  tokenHash String    @unique
  scope     String    @default("REPORT_VIEW")
  expiresAt DateTime
  revokedAt DateTime?
  viewCount Int       @default(0)
  createdAt DateTime  @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reading CompleteReading? @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@index([readingId])
}

// ─── Configuration & entitlements ───────────────────────────────────────────

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String // JSON
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model City {
  id        String  @id @default(cuid())
  name      String
  region    String?
  country   String
  latitude  Float
  longitude Float
  timezone  String

  @@index([name])
}

model Plan {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String
  features    String // JSON array
  priceMinor  Int?
  currency    String  @default("INR")
  active      Boolean @default(true)
}

model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  planCode  String
  readingId String?
  status    String   @default("ACTIVE")
  source    String   @default("FREE")
  grantedAt DateTime @default(now())
  expiresAt DateTime?
  metadata  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model PaymentTransaction {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerOrderId   String?  @unique
  providerPaymentId String?
  amountMinor       Int
  currency          String   @default("INR")
  status            String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  idempotencyKey    String   @unique
  metadata          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
